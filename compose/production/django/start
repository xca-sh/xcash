#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

eval "$(python /app/config/performance.py shell-env web)"

# 普通启动仍自动初始化；upgrade.sh 仅在生产迁移和初始化都成功后，通过本次
# Compose override 传 --prepared，避免在 HTTP 停机窗口内重复加载 Django 和查库。
case "${1:-}" in
  "") python -u manage.py bootstrap_runtime ;;
  --prepared) ;;
  *) echo "unknown startup argument: $1" >&2; exit 1 ;;
esac

# --max-requests + jitter：worker 处理满额请求后优雅重启，周期性回收常驻内存
# （ORM/模板/三方库缓存累积），避免 gthread worker 长期运行内存只增不减。
# jitter 打散重启时点，防止所有 worker 同时回收造成瞬时拒服。
exec gunicorn config.wsgi:application \
  --bind 0.0.0.0:8000 \
  --chdir=/app \
  --worker-class gthread \
  --workers "${GUNICORN_WORKERS}" \
  --threads 4 \
  --no-control-socket \
  --max-requests 1000 \
  --max-requests-jitter 200
