#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset

# schedule 落在容器内 /tmp，随容器重建丢失，属【有意选择】：本项目 beat_schedule
# 全部由代码定义（config/celery.py），没有 DatabaseScheduler 那种运行期动态改调度的
# 需求，落盘状态只用于记住「上次执行时刻」。代价是容器重建后间隔型任务从启动时刻重新
# 计时，首次投递要等满一个周期，晚一个周期可以接受；worker 健康探针例外，启动即投递
# （见 config/celery.py 的 WorkerHealthFirstScheduler），升级脚本据此确认调度已恢复。
# 换成持久卷反而有害：陈旧的 last_run 会让重建后的 beat 按旧调度补跑。
exec celery -A config.celery beat -l WARNING -s /tmp/celerybeat-schedule
