# 版本控制、CI 与本地环境目录：镜像内一律用不到
.editorconfig
.gitattributes
.github
.gitignore
.gitlab-ci.yml
.idea
.pre-commit-config.yaml
.readthedocs.yml
.travis.yml
venv
.venv
.git
.envs/
logs/
docs/
staticfiles/

# Python 生成文件
__pycache__/
*.pyc
*.pyo
*.pyd

# 类型检查 / Lint 缓存
.mypy_cache/
.ruff_cache/
.pytest_cache/

# 依赖缓存
pip-wheel-metadata/
wheels/
node_modules/
pay-fronted/node_modules/

# 编辑器 / IDE
.idea/
.vscode/
*.swp
*~
# Docker 忽略规则不会像 Git 一样自动匹配任意层级；运行密钥只能在启动时注入。
**/.env*
# 本地主网部署目录含独立凭据与运维产物，不属于应用运行源码。
xcash/tron/mainnet_deployment/

# 系统文件
.DS_Store
Thumbs.db

# 日志
*.log

# 运维敏感产物：备份与失败演练可能留下生产库 dump。生产镜像是 COPY . /app，若不排除，下一次
# docker compose build 会把含加密助记词、商户与账单数据的完整 dump 打进镜像层。
**/backups/
**/*.dump
**/*.sql
